{
  "name": "aziiki",
  "private": true,
  "version": "1.19.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "desktop:prep": "vite build && rm -rf desktop/app && cp -R dist desktop/app",
    "desktop:mac": "npm run desktop:prep && cd desktop && npm install && npm run build:mac",
    "desktop:win": "npm run desktop:prep && cd desktop && npm install && npm run build:win"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/node": "^10.74.0",
    "@sentry/react": "^10.74.0",
    "@supabase/supabase-js": "^2.45.4",
    "@tailwindcss/vite": "^4.1.14",
    "@upstash/redis": "^1.34.3",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "html2canvas-pro": "^2.3.3",
    "jspdf": "^4.2.1",
    "mime-types": "^3.0.2",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "resend": "^6.17.2",
    "vite": "^6.2.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "terser": "^5.51.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-compression": "^0.5.1"
  }
}
