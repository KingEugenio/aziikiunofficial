# Copy this file to .env and fill in every value below before running
# `npm run dev` - the server refuses to start if any required variable is
# missing or malformed (see src/server/env.ts).

NODE_ENV=development
PORT=5173

# Supabase project settings (Project Settings -> API in your Supabase dashboard).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Same Supabase URL/anon key, but read by the frontend at BUILD time (Vite
# only exposes env vars prefixed VITE_ to browser code). Keep these in sync
# with the two above.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Upstash Redis - backs rate limiting and the short-lived /api/sync cache.
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Public URL this app is served from - used in emailed links (password
# reset, magic link, team invites).
APP_URL=http://localhost:5173

# Optional: the AI CFO Advisor feature is disabled without this, everything
# else works fine. GEMINI_API_KEY_2/_3 are optional extra keys for
# automatic failover - see src/server/geminiClient.ts for why they only
# help if they come from separate Google Cloud projects with independent quota.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Optional: emailing invoices/receipts is disabled without this.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Aziiki <no-reply@yourdomain.com>"

# Optional: Paystack payment collection on invoices is disabled without this.
PAYSTACK_SECRET_KEY=

# Optional: server-side error monitoring (Sentry) is disabled without this.
# Create a free project at sentry.io, use its Node project's DSN here.
SENTRY_DSN=

# Optional: client-side error monitoring (Sentry) is disabled without this.
# Use a separate React project's DSN from sentry.io - VITE_ vars are public,
# a Sentry DSN is safe to expose (it can only submit events, not read data).
VITE_SENTRY_DSN=
